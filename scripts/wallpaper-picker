#!/usr/bin/env python3
"""Wallpaper-Picker mit Vorschau – Seducing Purple.

Pfeile/Maus: auswählen   Enter/Doppelklick: setzen   N: NSFW ein/aus   Esc: schließen
Setzen passiert per awww mit smooth wave-Verlauf.
"""
import hashlib
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk

HOME = Path.home()
MAIN_DIR = HOME / ".local/share/wallpapers"
NSFW_DIR = MAIN_DIR / "nsfw"
CACHE = HOME / ".cache/wallpaper-picker"
EXTS = {".png", ".jpg", ".jpeg", ".webp"}

# Smooth Verlauf: wave, lange Dauer, kleiner Step = weicher Übergang
TRANSITION = ["--transition-type", "wave", "--transition-duration", "3", "--transition-step", "15"]

CSS = """
window {
  background-image: linear-gradient(135deg, #14101f 0%, #2e1a5c 55%, #1a122b 100%);
  color: #efeaff;
}
headerbar {
  background: linear-gradient(90deg, rgba(154,102,255,.28), rgba(46,26,92,.35));
  border-bottom: 1px solid #9a66ff;
}
headerbar title label { font-weight: 700; }
.hint { color: #9d8fc2; font-size: 12px; }
.status { color: #c9b8ff; font-size: 13px; font-weight: bold; }
.preview-frame {
  background: rgba(26,18,43,.55);
  border: 1px solid rgba(154,102,255,.55);
  border-radius: 16px;
}
.fname { font-family: 'JetBrainsMono Nerd Font'; font-size: 13px; color: #c9b8ff; padding: 6px 2px; }
.scroll { background: transparent; }
scrollbar { background: rgba(26,18,43,.4); }
scrollbar slider { background: #9a66ff; border-radius: 8px; min-width: 8px; }
flowbox { background: transparent; padding: 4px; }
flowboxchild {
  background: rgba(26,18,43,.5);
  border: 2px solid transparent;
  border-radius: 10px;
  margin: 5px;
  padding: 3px;
  transition: border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
}
flowboxchild:selected {
  border-color: #9a66ff;
  background: rgba(154,102,255,.2);
  box-shadow: 0 0 18px rgba(154,102,255,.85);
}
flowboxchild.current { border-color: #c9b8ff; }
.badge {
  background: #9a66ff;
  color: #1a122b;
  font-size: 10px;
  font-weight: bold;
  border-radius: 6px;
  padding: 1px 7px;
  margin-top: 4px;
}
"""


def list_wallpapers(show_nsfw: bool):
    files = sorted(p for p in MAIN_DIR.iterdir() if p.suffix.lower() in EXTS and p.is_file())
    if show_nsfw and NSFW_DIR.is_dir():
        files += sorted(p for p in NSFW_DIR.iterdir() if p.suffix.lower() in EXTS and p.is_file())
    return files


def thumb_for(path: Path) -> Path:
    CACHE.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha1(f"{path}|{path.stat().st_mtime_ns}".encode()).hexdigest()[:16]
    out = CACHE / f"{key}.jpg"
    if not out.exists():
        subprocess.run(
            ["magick", str(path), "-thumbnail", "480x270", "-quality", "80", str(out)],
            check=False, capture_output=True,
        )
    return out if out.exists() else path


def current_wallpaper():
    try:
        r = subprocess.run(["awww", "query"], capture_output=True, text=True, timeout=5)
        for line in r.stdout.splitlines():
            if "image:" in line:
                return line.split("image:", 1)[1].strip()
    except Exception:
        pass
    return None


def apply_wallpaper(path: Path) -> None:
    subprocess.Popen(["awww", "img", *TRANSITION, str(path)])


def preload_thumbs(paths):
    for p in paths:
        thumb_for(p)


class Picker(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="dev.roman.wallpaper-picker")
        self.show_nsfw = True
        self.paths = []
        self.current = current_wallpaper()
        self._load_src = None
        self._flip = 0

    def do_activate(self):
        win = self.props.active_window
        if win:
            win.present()
            return
        self._build_window()

    # ---------- UI ----------
    def _build_window(self):
        win = Gtk.ApplicationWindow(application=self, title="Wallpaper-Picker")
        win.set_default_size(1360, 800)
        win.add_css_class("win")

        css = Gtk.CssProvider()
        try:
            css.load_from_string(CSS)
        except AttributeError:
            css.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Header
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        titles.append(Gtk.Label(label="◈  Wallpaper-Picker — Seducing Purple"))
        hints = Gtk.Label(
            label="Pfeile/Maus: auswählen · Enter/Doppelklick: setzen · N: NSFW · Esc: schließen"
        )
        hints.add_css_class("hint")
        titles.append(hints)
        self.status = Gtk.Label(label="")
        self.status.add_css_class("status")
        header = Gtk.HeaderBar(title_widget=titles)
        header.pack_end(self.status)
        win.set_titlebar(header)

        # Große Vorschau (Crossfade beim Scrollen)
        self.stack = Gtk.Stack(
            transition_type=Gtk.StackTransitionType.CROSSFADE,
            transition_duration=200,
        )
        self.pics = []
        for i in range(2):
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER)
            pic.set_size_request(700, 400)
            self.stack.add_named(pic, str(i))
            self.pics.append(pic)
        self.stack.set_visible_child_name("0")

        self.fname = Gtk.Label(label="", xalign=0)
        self.fname.add_css_class("fname")
        self.badge = Gtk.Label(label="NSFW", xalign=0)
        self.badge.add_css_class("badge")
        self.badge.set_visible(False)

        preview_col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        frame.set_margin_top(14)
        frame.set_margin_start(14)
        frame.set_margin_bottom(6)
        frame.append(self.stack)
        frame.add_css_class("preview-frame")
        nameline = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        nameline.set_margin_start(16)
        nameline.set_margin_bottom(10)
        nameline.append(self.fname)
        nameline.append(self.badge)
        preview_col.append(frame)
        preview_col.append(nameline)
        preview_col.set_hexpand(True)

        # Thumbnail-Raster
        self.flow = Gtk.FlowBox()
        self.flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flow.set_activate_on_single_click(False)
        self.flow.set_min_children_per_line(2)
        self.flow.set_max_children_per_line(3)
        self.flow.set_row_spacing(0)
        self.flow.set_column_spacing(0)
        self.flow.set_valign(Gtk.Align.START)
        self.flow.connect("selected-children-changed", self.on_sel)
        self.flow.connect("child-activated", lambda fb, child: self.apply_selected())

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_size_request(560, -1)
        scroller.set_child(self.flow)
        scroller.add_css_class("scroll")

        paned = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        sep.set_margin_top(14)
        sep.set_margin_bottom(14)
        paned.append(preview_col)
        paned.append(sep)
        paned.append(scroller)

        win.set_child(paned)

        key = Gtk.EventControllerKey()
        key.connect("key-pressed", self.on_key)
        win.add_controller(key)

        self.rebuild()
        self.flow.grab_focus()
        win.present()

    def rebuild(self):
        while (child := self.flow.get_first_child()) is not None:
            self.flow.remove(child)
        self.paths = list_wallpapers(self.show_nsfw)
        for path in self.paths:
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER)
            pic.set_size_request(172, 97)
            pic.set_file(Gio.File.new_for_path(str(thumb_for(path))))
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            tile.append(pic)
            if NSFW_DIR in path.parents:
                chip = Gtk.Label(label="NSFW")
                chip.add_css_class("badge")
                tile.append(chip)
            child = Gtk.FlowBoxChild()
            child.set_child(tile)
            self.flow.insert(child, -1)
        self._mark_current()
        if self.paths:
            first = self.flow.get_child_at_index(0)
            if first:
                self.flow.select_child(first)

    def _mark_current(self):
        if not self.current:
            return
        for i, path in enumerate(self.paths):
            if str(path) == self.current:
                child = self.flow.get_child_at_index(i)
                if child:
                    child.add_css_class("current")

    # ---------- Interaktion ----------
    def on_sel(self, _flow):
        sel = self.flow.get_selected_children()
        if not sel:
            return
        idx = sel[0].get_index()
        path = self.paths[idx]
        self.fname.set_text(f"{path.name}   ·   {self._dims(path)}")
        self.badge.set_visible(NSFW_DIR in path.parents)
        self.status.set_label("")
        if self._load_src:
            GLib.source_remove(self._load_src)
        self._load_src = GLib.timeout_add(110, lambda: (self._load_preview(path), False)[1])

    def _dims(self, path: Path) -> str:
        try:
            from PIL import Image
            with Image.open(path) as im:
                return f"{im.width}×{im.height}"
        except Exception:
            return "?"

    def _load_preview(self, path: Path):
        self._load_src = None
        name = "1" if self._flip == 0 else "0"
        self._flip = 1 - self._flip
        self.pics[int(name)].set_file(Gio.File.new_for_path(str(path)))
        self.stack.set_visible_child_name(name)

    def apply_selected(self):
        sel = self.flow.get_selected_children()
        if not sel:
            return
        path = self.paths[sel[0].get_index()]
        apply_wallpaper(path)
        self.current = str(path)
        for i in range(len(self.paths)):
            child = self.flow.get_child_at_index(i)
            if child:
                child.remove_css_class("current")
        sel[0].add_css_class("current")
        self.status.set_label("✓ gesetzt")

    def on_key(self, _ctrl, keyval, _keycode, _state):
        if keyval == Gdk.KEY_Escape:
            self.props.active_window.close()
            return True
        if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.apply_selected()
            return True
        if keyval in (Gdk.KEY_n, Gdk.KEY_N):
            self.show_nsfw = not self.show_nsfw
            self.rebuild()
            self.status.set_label("NSFW an" if self.show_nsfw else "NSFW aus")
            return True
        return False


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "--apply":
        p = Path(sys.argv[2]).expanduser()
        if not p.is_file():
            sys.exit(f"nicht gefunden: {p}")
        apply_wallpaper(p)
        print(f"gesetzt: {p}")
        return
    paths = list_wallpapers(True)
    preload_thumbs(paths)
    Picker().run(sys.argv)


if __name__ == "__main__":
    main()
