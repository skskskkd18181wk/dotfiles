#!/bin/sh
# RTX 2080 Ti OC – persistente Einstellungen (braucht sudo)
# Sustained ~1920 MHz (vs ~1755 ref boost), 330W limit, getestet gpu_burn 3min 0 Err
S="echo Roman1997 | sudo -S -p ''"

# Persistence + Power-Limit max (Gaming X Trio: 330W)
$S nvidia-smi -pm 1 >/dev/null 2>&1
$S nvidia-smi -pl 330 >/dev/null 2>&1

# Clock-Lock: V/F-Kurve zieht auf ~1920 unter Last (Reliability-Limit)
# Hoch genug setzen damit Boost nicht auf Stock-Basis runterregelt
$S nvidia-smi -lgc 2100,2190 >/dev/null 2>&1

exit 0
